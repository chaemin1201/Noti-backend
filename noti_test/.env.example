# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요. (.env 는 git 에 올리지 마세요!)

# --- AI 키: 둘 중 하나만 있으면 됩니다 ---
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- 사용할 AI ---
# LLM_PROVIDER=google          # google 또는 anthropic (키가 하나뿐이면 생략해도 자동 선택)
# LLM_FALLBACK_MODEL=            # 기본 모델이 혼잡할 때 대신 쓸 모델 (--find-model --save 가 채워 줍니다)
LLM_MODEL=                     # 모르면 비워 두고 `python llm.py --find-model --save` 를 실행하세요

# --- 문제를 실제로 등록할 때만 필요 ---
# NOTI_TOKEN=

# --- 선택: 생각(thinking) 줄이기. 요청이 무거워 실패할 때만 (Gemini 3 계열: low 권장 / 2.5 계열: 숫자, 0=끔) ---
# LLM_THINKING=low
