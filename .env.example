# 문제지 업로드(intake) 서버 설정. 이 파일은 git 에 올리지 마세요 (.gitignore 에 등록됨).
# 읽는 위치: 현재 폴더 → inputdata/intake 폴더 → 그 상위 2단계 (이 파일이 있는 폴더가 해당). 이미 설정된 환경변수는 덮어쓰지 않습니다.

# --- AI ---
GEMINI_API_KEY=여기에_키
LLM_MODEL=gemini-모델이름  # python llm.py --find-model --save 로 찾기
LLM_THINKING=low
# 기본 모델이 혼잡할 때 대신 쓸 모델. 응답하지 않는 모델을 넣으면 대기만 길어지니 `python llm.py --diagnose` 로 확인한 뒤 켜세요.
# LLM_FALLBACK_MODEL=

# --- 정답 코드 실행 검증 (기본 꺼짐) ---
# AI 가 쓴 코드를 서버에서 실행합니다. 네트워크가 막히고 파일시스템이 읽기 전용인 비루트 컨테이너에서만 두 값을 함께 켜세요.
# INTAKE_EXEC=on
# INTAKE_EXEC_ISOLATED=on
# 컨테이너가 네트워크를 이미 막았고 unshare 를 쓸 수 없을 때만:
# INTAKE_EXEC_NO_NET=off

# --- 처리 한도 (기본값이면 생략) ---
# INTAKE_MAX_FILE_MB=20
# INTAKE_MAX_FILES=5
# INTAKE_MAX_PROBLEMS=200
# INTAKE_HEARTBEAT_SEC=120
# INTAKE_MAX_TOKENS=20000        # AI 한 번의 출력 한도
# INTAKE_AI_ITEM_TIMEOUT=900     # 문제 하나의 AI 호출(재시도 포함) 제한 시간(초)

# --- Gemini 말고 다른 서비스를 쓸 때 (OpenAI 호환 방식: OpenAI, Groq, OpenRouter, 사내 게이트웨이 등) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=서비스 주소          (끝은 /v1 처럼 chat/completions 앞까지)
# LLM_API_KEY=키
# LLM_MODEL=모델 이름
# LLM_STREAM=on                  # 기본 on. 앞단 게이트웨이가 100초쯤 응답이 없으면 524 로 끊는 서비스에서 필요
# LLM_EXTRA_BODY={"reasoning_effort":"low"}   # 서비스가 받는 추가 요청 값(생각 줄이기 등). JSON 한 줄
# LLM_MAX_TOKENS_PARAM=max_completion_tokens  # 새 OpenAI 모델처럼 요청 변수 이름이 다를 때
# LLM_TEMPERATURE=0              # 지정했을 때만 보냄
