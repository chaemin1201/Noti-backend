{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep * *.env*)",
      "Bash(sed * *.env*)",
      "Bash(cp *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(gc *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "PowerShell(Select-String * *.env*)",
      "PowerShell(Copy-Item *.env*)"
    ]
  }
}
