 ENV TZ=Asia/Seoul
 
+# ── 문제지 업로드(intake): 원본 캡처용 LibreOffice (워드·PPT·한글을 쪽 이미지로 바꿈) ──
+# 이미지가 약 500MB 커진다. 필요 없으면 빌드할 때 --build-arg INSTALL_OFFICE=false (그러면 PDF 만 캡처하고 나머지는 읽은 글로 보여 줌)
+ARG INSTALL_OFFICE=true
+RUN if [ "$INSTALL_OFFICE" = "true" ]; then \
+      apt-get update && apt-get install -y --no-install-recommends libreoffice-writer libreoffice-impress \
+      && rm -rf /var/lib/apt/lists/*; \
+    fi
+
 # ── 권한 격하 (UID 1000) ───────────────────────────────────
 RUN groupadd -g 1000 appuser || true && \
     useradd -u 1000 -g appuser -m -s /bin/bash appuser || true
